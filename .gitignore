# Generated site build — regenerate with: python3 pipeline/build_site.py
/site/

# Build artifacts — DERIVED from sources, regenerated by CI (.github/workflows/deploy.yml).
# Contributing = editing only metadata.json + text.txt + the source file; never these.
# (build_index.py builds index.json; build_formats.py builds reader.*; subset_fonts.py
#  builds the woff2 subset — fontface.css and assets/fonts-full/ stay tracked.)
/archives/index.json
archives/authors/*/*/reader.html
archives/authors/*/*/reader.epub
/assets/fonts/*.woff2

# Personal deploy notes — keep out of the repo
/DEPLOY_NOTES.md

# Python
__pycache__/
*.pyc
*.pyo

# OS / editor cruft
.DS_Store
*.swp
*~

# Font-subset scratch + प्रमिथस work-in-progress (recovery for the scheduled finalize run)
/.used_glyphs.tmp
/.pramithas_wip/

# Resumable scanned-book DAG state (heavy OCR artifacts live in OCR_WORK_DIR)
/.ocr-work/

# Unpublished source-ingestion snapshots, editorial exclusions, and review drafts
/.ingest-work/

# API keys — never commit

# Local agent/tool bindings — public files describe capabilities, not vendors
/ocr/agent_profiles.local.json
/ocr/local_paths.json
/horoscope/generation.local.yaml

# Private research workspace — not part of Nepali Archives
/economic_analysis/
.env
**/.env
