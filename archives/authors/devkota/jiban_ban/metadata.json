        "id": "mandakranta-ending",
        "metre": "mandakranta",
        "label": "समापन श्लोक",
        "start": "काँढा कुल्चे फूल फुलदछन्, आँसु नै मोति हुन्छन्",
        "end": "धर्मैको हो पथ पथिक हो ! धर्म हो एक आस ।।"
