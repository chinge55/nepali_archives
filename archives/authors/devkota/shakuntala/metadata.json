        "id": "bhujanga-example",
        "metre": "bhujanga",
        "label": "चतुर्थ सर्ग · श्लोक ४",
        "start": "नटी मेनका छम्छमाउन् अगाडि ।",
        "end": "    मसीनो कलाको भजी मोहजादू ॥"
      },
      {
        "id": "vasanta-example",
        "metre": "vasanta",
        "label": "सप्तम सर्ग · श्लोक १२ का पहिले दुई पाउ",
        "start": "ऐनासमान हलपी जलतुल्य साफ ।",
        "end": "    निष्पाप शुद्ध दिलमा नभएर ताप ॥"
      },
      {
        "id": "shardul-example",
        "metre": "shardul",
        "label": "प्रथम सर्ग · श्लोक १ का पहिले दुई पाउ",
        "start": "चिम्ली लोचन दीर्घकाल तपमा खोलेर वासन्तिका ।",
        "end": "    नाच्दी सुन्दर तालले पवनमा देखी फुलेकी लता ॥"
      },
      {
        "id": "malini-example",
        "metre": "malini",
        "label": "द्वितीय सर्ग · श्लोक १ का पहिले दुई पाउ",
        "start": "विपिन छ बहु-शाखा-रम्य, ऊँचा विशाल ।",
        "end": "    विटपदलहरुको शीतल स्निग्धजाल ॥"
      },
      {
        "id": "shikharini-example",
        "metre": "shikharini",
        "label": "द्वितीय सर्ग · श्लोक १८ का पहिले दुई पाउ",
        "start": "यहाँ आए कोही दिन बहुत तेजी नृपवर ।",
        "end": "    जगज्जेता बन्ने प्रबल मनमा कीर्तिशिखर ॥"
      },
      {
        "id": "totaka-example",
        "metre": "totaka",
        "label": "तृतीय सर्ग · श्लोक १ का अन्तिम दुई पाउ",
        "start": "सुनको भव भो सुनको जलले ।",
        "end": "    सुन तार बजाउँछ कल्कलले ॥"
      },
      {
        "id": "drutavilambita-example",
        "metre": "drutavilambita",
        "label": "तृतीय सर्ग · श्लोक २५ का पहिले दुई पाउ",
        "start": "कनककान्ति छ बादल खुट्किला ।",
        "end": "    सुरपुरीतिरको नभ सान्ध्यमा ॥"
      },
      {
        "id": "shalini-example",
        "metre": "shalini",
        "label": "सप्तम सर्ग · श्लोक ५० का पहिले दुई पाउ",
        "start": "यस्तै लीला बाल्यमा चारु खेली ।",
        "end": "    मीठो पाई सौख्य जस्ती हवेली ॥"
      },
      {
        "id": "sragdhara-example",
        "metre": "sragdhara",
        "label": "सप्तम सर्ग · श्लोक ५३ को दोस्रो पाउ",
        "start": "    बढ्थिन् ती मालिनीका तट निकट हुने भावमा दिव्य रङ्गी ॥",
        "end": "    बढ्थिन् ती मालिनीका तट निकट हुने भावमा दिव्य रङ्गी ॥"
      },
      {
        "id": "mandakranta-example",
        "metre": "mandakranta",
        "label": "सप्तदश सर्ग · श्लोक १ का अन्तिम दुई पाउ",
        "start": "लाली राम्रो गगनपटमा बस्छ है थोर काल ।",
        "end": "स्वर्णाभाका पथि तिमिरले दुःखको फिँज्छ जाल ॥"
      }
    ]
  }
