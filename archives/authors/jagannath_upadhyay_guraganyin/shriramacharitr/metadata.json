        "note": "श्रीरामचरित्रको मुख्य कथा शार्दूल र दुर्वासाको स्तुति शिखरिणीमा छ। शिव–पार्वतीको अन्तिम दुई लिखित हरफ वियोगिनीका चार पाउमा पढिएका। हस्ताक्षरयुक्त आखिरी श्लोकको भुजङ्ग-जस्तो पठन यो आंशिक सूचीमा निश्चित गरिएको छैन।"
      }
    ],
    "passages": [
      {
        "id": "shardul-1",
        "metre": "shardul",
        "label": "कैलाशको आरम्भ",
        "start": "लाखौँ चन्द्रसरी मनोहर–पुरी कैलाश दरबारमा ।",
        "end": "लागिन् सोध्न ति पार्वती चरणमा पस्रेर विन्ती गरी ॥"
      },
      {
        "id": "shikharini-2",
        "metre": "shikharini",
        "label": "दुर्वासाको स्तुति",
        "start": "अये सीतानाथ ! त्रिभुवन विधाता ! रघुपते,",
        "end": "प्रभुकै यो साक्षात् सकल जग हो खेल रमिता ॥"
      },
      {
        "id": "viyogini-3",
        "metre": "viyogini",
        "label": "शिव–पार्वती समापन",
        "start": "कही राम कथा अपार यो, शिवजीको मन राममै रह्यो",
        "end": "गिरिजा पनि यो सुनी कथा, मननै गर्न भनी बसिन् यता ॥"
      }
    ]
  }
